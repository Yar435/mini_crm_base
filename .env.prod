# ===== Django =====
DJANGO_SECRET_KEY="change-me-in-prod"
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web,nginx

# Database (match docker-compose postgres service)
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}
FLOWER_BROKER_URL=${CELERY_BROKER_URL}

# Sentry (optional)
SENTRY_DSN=
SENTRY_ENV=prod
SENTRY_RELEASE=

# Superuser (only for first run; then remove)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin


SECURE_SSL_REDIRECT=0
